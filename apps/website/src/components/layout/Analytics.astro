---
// Cloudflare Web Analytics (cookieless). Only rendered in production builds
// that set PUBLIC_CF_ANALYTICS_TOKEN, so dev and forks ship no beacon.
const token = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const enabled = import.meta.env.PROD && Boolean(token);
---

{
  enabled && (
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={JSON.stringify({ token })}
    />
  )
}
